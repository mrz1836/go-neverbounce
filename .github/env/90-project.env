# ================================================================================================
# 🏗️ PROJECT-SPECIFIC CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for go-neverbounce
# Load Order: 90 (loaded near-last, overrides all default and tool-specific settings)
#
# This file contains configuration values unique to this project that override
# defaults from earlier env files (00-core, 10-*, 20-*).
#
# Only add variables here that differ from the upstream defaults.
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# go.mod declares `go 1.26`: CI runs the supported baseline, 1.26.x, as both the primary and the
# secondary version.
GO_PRIMARY_VERSION=1.26.x
GO_SECONDARY_VERSION=1.26.x

# ================================================================================================
# 🪄 MAGE-X GO VERSION OVERRIDES
# ================================================================================================

MAGE_X_GO_VERSION=1.26.x
MAGE_X_GO_SECONDARY_VERSION=1.26.x

# ================================================================================================
# 📊 COVERAGE OVERRIDES
# ================================================================================================

# Coverage provider (overrides 10-coverage.env default of "internal")
GO_COVERAGE_PROVIDER=codecov

# Codecov requires a token for this project
CODECOV_TOKEN_REQUIRED=true

# Coverage exclusion paths (aligned with codecov.yml ignore paths)
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/,test/,vendor/,testdata/,plans/,docs/,internal/testutil/

# Skip URL checks in coverage reports
GO_COVERAGE_SKIP_URL_CHECKS=true

# ================================================================================================
# 🏷️ BUILD TAG OVERRIDES
# ================================================================================================

# The live contract probe (live_probe_internal_test.go, build tag "live") can make billable calls
# to NeverBounce. Keep it out of auto-discovered tag runs (magex test, magex bench, CI): it is run
# only by hand, with the owner's approval. The list is 10-mage-x.env's default plus "live".
MAGE_X_AUTO_DISCOVER_BUILD_TAGS_EXCLUDE=race,custom,msan,asan,cgo,gc,gccgo,boringcrypto,unix,aix,android,darwin,dragonfly,freebsd,hurd,illumos,ios,js,linux,nacl,netbsd,openbsd,plan9,solaris,wasip1,windows,zos,386,amd64,amd64p32,arm,armbe,arm64,arm64be,loong64,mips,mipsle,mips64,mips64le,mips64p32,mips64p32le,ppc,ppc64,ppc64le,riscv,riscv64,s390,s390x,sparc,sparc64,wasm,live
